  push R0
  push R1
  push R2
  push R3

  loadn R0, #tela4
  loadn R1, #0
  loadn R2, #1200

  printtela4ScreenLoop:

    add R3,R0,R1
    loadi R3, R3
    outchar R3, R1
    inc R1
    cmp R1, R2

    jne printtela4ScreenLoop

  pop R3
  pop R2
  pop R1
  pop R0
  rts
    
    ;TELA BASE 
    
    ; =========================================================
    ; SUBROTINA: get_tela_base
    ; =========================================================
    ; Retorna em r5 o endereço base do array da tela ativa.
    ; Entrada: tela_atual (variável global, valor 0..3)
    ; Saída:   r5 = endereço base (tela1, tela2, tela3 ou tela4)
    ; Usada internamente para calcular o endereço de um tile:
    ;   endereço_tile = base_tela + pos_linear
    ; =========================================================
get_tela_base:
    push r0
    load r0, tela_atual
    loadn r5, #1
    cmp r0, r5
    jeq gb_tela2
    loadn r5, #2
    cmp r0, r5
    jeq gb_tela3
    loadn r5, #3
    cmp r0, r5
    jeq gb_tela4
    loadn r5, #tela1
    jmp gb_fim
gb_tela2:
    loadn r5, #tela2
    jmp gb_fim
gb_tela3:
    loadn r5, #tela3
    jmp gb_fim
gb_tela4:
    loadn r5, #tela4
gb_fim:
    pop r0
    rts
