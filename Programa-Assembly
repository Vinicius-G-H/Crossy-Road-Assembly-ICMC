; =============================================================================
; JOGO CROSSY ROAD — Arquivo principal
; =============================================================================
; Visão geral:
;   O jogador ('X') navega em uma grade de 30 linhas x 40 colunas.
;   Ele se move com W/A/S/D. Ao ultrapassar o topo da tela (wrap vertical)
;   a pontuação aumenta e o mapa troca. Inimigos (letras Y,Z,H,K,W,U,L,Q)
;   movem-se horizontalmente em faixas fixas. Colisão = Game Over.
;
; Layout de memória (posição linear = linha*40 + coluna):
;   Tela: 30 linhas x 40 colunas = 1200 posições (0..1199)
;   Jogador começa em pos 1179 (linha 29, coluna 19)
;
; Registradores usados no loop principal:
;   r1 = coluna do jogador (0..39)
;   r2 = linha  do jogador (0..29)
;   r3 = posição linear calculada (r2*40 + r1)
;   r4 = caractere espaço (' ') — usado para apagar
;   r7 = caractere do jogador ('X')
; =============================================================================
   jmp main 

    main:       

        ; === NOVA ROTINA DE LIMPEZA INICIAL ===
        loadn r0, #' '      ; Caractere vazio
        loadn r1, #0        ; Posição inicial
        loadn r2, #1200     ; Total de posições da tela (30 linhas * 40 colunas)
    limpa_inicio:
        outchar r0, r1
        inc r1
        cmp r1, r2
        jne limpa_inicio
        
        ;chama a tela 1
        call printtela1Screen    
        

           
        ; ========================================
        ; --- Espaço de Memória ---
        ; Variáveis globais do jogo alocadas em memória estática.
        ; Cada 'var #1' reserva uma célula de memória.
        ;
        ; Convenção de nomenclatura:
        ;   pos_X_inimigo  = posição linear atual do inimigo X na tela
        ;   X_delay_cnt    = contador de ciclos até o próximo movimento de X
        ;   X_start        = posição de início da faixa (wrap horizontal)
        ; ======================================
    tela_atual: var #1
    
    pos_anterior: var #1
    
    pos_q_inimigo: var #1    
    q_delay_cnt:   var #1    

    pos_u_inimigo: var #1    
    u_delay_cnt:   var #1    

    l_start:       var #1
    pos_l_inimigo: var #1    
    l_delay_cnt:   var #1    

    pos_k_inimigo: var #1    
    k_delay_cnt:   var #1    

    w_start:        var #1
    pos_w_inimigo: var #1    
    w_delay_cnt:   var #1 

    pos_h_inimigo: var #1    
    h_delay_cnt:   var #1    

    pos_y_inimigo: var #1  
    y_delay_cnt:   var #1    

    pos_z_inimigo: var #1    
    z_delay_cnt:   var #1    

    pontuacao:     var #1

    game_speed:    var #1

    extra_steps: var #1

    wrap_vertical_cnt: var #1

    pos_y2_inimigo: var #1
    y2_delay_cnt:   var #1

    pos_y3_inimigo: var #1
    y3_delay_cnt:   var #1

    pos_z2_inimigo: var #1
    z2_delay_cnt:   var #1

    pos_z3_inimigo: var #1
    z3_delay_cnt:   var #1

    pos_h2_inimigo: var #1
    h2_delay_cnt:   var #1

    pos_h3_inimigo: var #1
    h3_delay_cnt:   var #1

    pos_q2_inimigo: var #1
    q2_delay_cnt:   var #1

    pos_q3_inimigo: var #1
    q3_delay_cnt:   var #1

    pos_u2_inimigo: var #1
    pos_l2_inimigo: var #1
    u2_delay_cnt:   var #1

    pos_u3_inimigo: var #1
    pos_l3_inimigo: var #1
    u3_delay_cnt:   var #1

    pos_k2_inimigo: var #1
    pos_w2_inimigo: var #1
    k2_delay_cnt:   var #1

    pos_k3_inimigo: var #1
    pos_w3_inimigo: var #1
    k3_delay_cnt:   var #1
    ; ------------------------

    ; =========================================================
    ; INICIALIZAÇÃO DAS VARIÁVEIS
    ; =========================================================
    ; Define os valores iniciais de todas as variáveis do jogo
    ; antes de entrar no loop principal.
    ;
    ; Grupos de inimigos e suas faixas horizontais na tela:
    ;   Y (linhas 3-5,  cols 0-39): move para a ESQUERDA, delay base 1
    ;   Z (linhas 7-9,  cols 0-39): move para a DIREITA,  delay base 2
    ;   H (linhas 11-13,cols 0-39): move para a DIREITA,  delay base 4
    ;   K/W(linhas 17-19,cols 0-39): par KW, esquerda,    delay base 3
    ;   U/L(linhas 1-2,  cols 0-39): par UL, direita,     delay base 5
    ;   Q  (linhas 22-24,cols 0-39): move para a DIREITA, delay base 2
    ;
    ; Cada grupo tem 3 instâncias (ex: Y, Y2, Y3) deslocadas
    ; 13 posições entre si para preencher a faixa horizontal.
    ; =========================================================
        ; salva posição inicial do jogador (linha 29 * 40 + coluna 19 = 1179)
        loadn r0, #1179
        store pos_anterior, r0
        
        loadn r0, #880
        store pos_q_inimigo, r0
        loadn r0, #0
        store q_delay_cnt, r0

        loadn r0, #893
        store pos_q2_inimigo, r0
        loadn r0, #0
        store q2_delay_cnt, r0

        loadn r0, #906
        store pos_q3_inimigo, r0
        loadn r0, #0
        store q3_delay_cnt, r0

        loadn r0, #40
        store pos_u_inimigo, r0
        loadn r0, #0
        store u_delay_cnt, r0

        loadn r0, #41
        store pos_l_inimigo, r0
        loadn r0, #40
        store l_start, r0 
        loadn r0, #0
        store l_delay_cnt, r0

        loadn r0, #53
        store pos_u2_inimigo, r0
        loadn r0, #54
        store pos_l2_inimigo, r0
        loadn r0, #0
        store u2_delay_cnt, r0

        loadn r0, #66
        store pos_u3_inimigo, r0
        loadn r0, #67
        store pos_l3_inimigo, r0
        loadn r0, #0
        store u3_delay_cnt, r0

        loadn r0, #680
        store pos_k_inimigo, r0
        loadn r0, #0
        store k_delay_cnt, r0

        loadn r0, #681
        store pos_w_inimigo, r0
        loadn r0, #680
        store w_start, r0
        loadn r0, #0
        store w_delay_cnt, r0

        loadn r0, #693
        store pos_k2_inimigo, r0
        loadn r0, #694
        store pos_w2_inimigo, r0
        loadn r0, #0
        store k2_delay_cnt, r0

        loadn r0, #706
        store pos_k3_inimigo, r0
        loadn r0, #707
        store pos_w3_inimigo, r0
        loadn r0, #0
        store k3_delay_cnt, r0

        loadn r0, #440
        store pos_h_inimigo, r0
        loadn r0, #0
        store h_delay_cnt, r0

        loadn r0, #453
        store pos_h2_inimigo, r0
        loadn r0, #0
        store h2_delay_cnt, r0

        loadn r0, #466
        store pos_h3_inimigo, r0
        loadn r0, #0
        store h3_delay_cnt, r0

        loadn r0, #120
        store pos_y_inimigo, r0
        loadn r0, #0
        store y_delay_cnt, r0

        loadn r0, #133
        store pos_y2_inimigo, r0
        loadn r0, #0
        store y2_delay_cnt, r0

        loadn r0, #146
        store pos_y3_inimigo, r0
        loadn r0, #0
        store y3_delay_cnt, r0

        loadn r0, #280
        store pos_z_inimigo, r0
        loadn r0, #0
        store z_delay_cnt, r0

        loadn r0, #293
        store pos_z2_inimigo, r0
        loadn r0, #0
        store z2_delay_cnt, r0

        loadn r0, #306
        store pos_z3_inimigo, r0
        loadn r0, #0
        store z3_delay_cnt, r0
        ;pontuação
        loadn r0, #0
        store pontuacao, r0

        ;velocidade global
        loadn r0, #0
        store game_speed, r0

        ;tela
        loadn r0, #0
        store tela_atual, r0
        
        ; --- Registradores fixos do jogador ---
        ; r7 = símbolo visual do jogador ('X')
        ; r1 = coluna inicial = 19 (centro horizontal)
        ; r2 = linha  inicial = 29 (última linha)
        ; r4 = caractere de espaço, usado para apagar rastro
        loadn r7, #'X'
        loadn r1, #19
        loadn r2, #29
        loadn r4, #' '

        loadn r0, #0
        store extra_steps, r0
        loadn r0, #0
        store wrap_vertical_cnt, r0

    ; =========================================================
    ; LOOP PRINCIPAL DO JOGO
    ; =========================================================
    ; Executado a cada ciclo (frame). Ordem de execução:
    ;   1. Calcula posição linear do jogador (r3 = r2*40 + r1)
    ;   2. Verifica colisão com todos os inimigos
    ;   3. Desenha o jogador na posição atual
    ;   4. Atualiza e desenha cada inimigo (delay + move + draw)
    ;   5. Lê teclado e processa movimento
    ;   6. Apaga a posição anterior do jogador
    ;   7. Volta para o início do loop
    ; =========================================================
    loop:
    ; ===== CALCULA POSIÇÃO LINEAR DO JOGADOR =====
    ; Fórmula: pos = linha * 40 + coluna  (r3 = r2*40 + r1)
    ; Como não há instrução MUL, a multiplicação é feita
    ; somando 40 repetidamente (r2 vezes) via loop multLoop.
        loadn r3, #0
        loadn r5, #0      
    multLoop:
        cmp r5, r2
        jeq somaX
        loadn r6, #40     ; soma 40 ao acumulador r3 (uma "linha")
    add40:
        inc r3
        dec r6
        jnz add40
        inc r5
        jmp multLoop

    somaX:
        add r3, r3, r1    ; adiciona a coluna ao resultado da multiplicação
    
    ; === SALVA POSIÇÃO ATUAL COMO ANTERIOR ===
    store pos_anterior, r3
    ; ==========================================  

; ===== DETECÇÃO DE COLISÃO =====
    ; Percorre os 24 inimigos (índices 0..23) e compara
    ; a posição linear de cada um com a posição do jogador (r3).
    ; Se qualquer posição coincidir -> salta para game_over.
    ;
    ; Índice -> Inimigo:
    ;   0=Y  1=Z  2=H  3=K  4=U  5=Q  6=L  7=W
    ;   8=Y2 9=Y3 10=Z2 11=Z3 12=H2 13=H3 14=Q2
    ;   15=Q3 16=U2 17=L2 18=U3 19=L3 20=K2 21=W2
    ;   22=K3 23=W3
    ;
    ; r0 = índice do inimigo corrente
    ; r3 = posição do jogador (não modificada)
    ; r5 = posição do inimigo carregada para comparação
    push r0
    push r4
    push r5

    loadn r0, #0
    loadn r4, #24       ; Verifica do índice 0 ao 23

loop_colisao:
    cmp r0, r4
    jeq fim_colisao

    ; Verificação dos índices para decidir qual posição carregar
    loadn r5, #0
    cmp r0, r5
    jeq col_y

    loadn r5, #1
    cmp r0, r5
    jeq col_z

    loadn r5, #2
    cmp r0, r5
    jeq col_h

    loadn r5, #3
    cmp r0, r5
    jeq col_k

    loadn r5, #4
    cmp r0, r5
    jeq col_u

    loadn r5, #5
    cmp r0, r5
    jeq col_q

    loadn r5, #6
    cmp r0, r5
    jeq col_l

    loadn r5, #7
    cmp r0, r5
    jeq col_w

    loadn r5, #8
    cmp r0, r5
    jeq col_y2

    loadn r5, #9
    cmp r0, r5
    jeq col_y3

    loadn r5, #10
    cmp r0, r5
    jeq col_z2

    loadn r5, #11
    cmp r0, r5
    jeq col_z3

    loadn r5, #12
    cmp r0, r5
    jeq col_h2

    loadn r5, #13
    cmp r0, r5
    jeq col_h3

    loadn r5, #14
    cmp r0, r5
    jeq col_q2

    loadn r5, #15
    cmp r0, r5
    jeq col_q3

    loadn r5, #16
    cmp r0, r5
    jeq col_u2

    loadn r5, #17
    cmp r0, r5
    jeq col_l2

    loadn r5, #18
    cmp r0, r5
    jeq col_u3

    loadn r5, #19
    cmp r0, r5
    jeq col_l3

    loadn r5, #20
    cmp r0, r5
    jeq col_k2

    loadn r5, #21
    cmp r0, r5
    jeq col_w2

    loadn r5, #22
    cmp r0, r5
    jeq col_k3

    loadn r5, #23
    cmp r0, r5
    jeq col_w3

    jmp fim_colisao     ; índice inesperado: encerra verificação

; --- Labels de carga de posição ---
col_y:
    load r5, pos_y_inimigo
    jmp compara

col_z:
    load r5, pos_z_inimigo
    jmp compara

col_h:
    load r5, pos_h_inimigo
    jmp compara

col_k:
    load r5, pos_k_inimigo
    jmp compara

col_u:
    load r5, pos_u_inimigo
    jmp compara             ; Faltava este jump no seu código

col_q:
    load r5, pos_q_inimigo
    jmp compara

col_l:
    load r5, pos_l_inimigo
    jmp compara

col_w:
    load r5, pos_w_inimigo
    jmp compara

col_y2:
    load r5, pos_y2_inimigo
    jmp compara

col_y3:
    load r5, pos_y3_inimigo
    jmp compara

col_z2:
    load r5, pos_z2_inimigo
    jmp compara

col_z3:
    load r5, pos_z3_inimigo
    jmp compara

col_h2:
    load r5, pos_h2_inimigo
    jmp compara

col_h3:
    load r5, pos_h3_inimigo
    jmp compara

col_q2:
    load r5, pos_q2_inimigo
    jmp compara

col_q3:
    load r5, pos_q3_inimigo
    jmp compara

col_u2:
    load r5, pos_u2_inimigo
    jmp compara

col_l2:
    load r5, pos_l2_inimigo
    jmp compara

col_u3:
    load r5, pos_u3_inimigo
    jmp compara

col_l3:
    load r5, pos_l3_inimigo
    jmp compara

col_k2:
    load r5, pos_k2_inimigo
    jmp compara

col_w2:
    load r5, pos_w2_inimigo
    jmp compara

col_k3:
    load r5, pos_k3_inimigo
    jmp compara

col_w3:
    load r5, pos_w3_inimigo
    jmp compara

compara:
    cmp r3, r5              ; r3 = posição do jogador, r5 = posição do inimigo
    jeq game_over

    inc r0                  ; Próximo inimigo
    jmp loop_colisao

fim_colisao:
    pop r5
    pop r4
    pop r0

    ; ===== DESENHA JOGADOR =====
    ; Nenhuma colisão detectada: exibe 'X' na posição atual (r3).
        outchar r7, r3

    ; =========================================================
    ; ATUALIZAÇÃO E DESENHO DOS INIMIGOS
    ; =========================================================
    ; Para cada inimigo o padrão é:
    ;
    ;   1. DELAY: incrementa contador; só move quando >= threshold.
    ;      O threshold = (base_delay - game_speed), mínimo 1.
    ;      Quanto maior game_speed, menor o threshold → mais rápido.
    ;
    ;   2. APAGA: restaura o pixel de fundo (tile da tela atual)
    ;      na posição antiga do inimigo antes de movê-lo.
    ;      Para isso lê o array estático da tela ativa e usa
    ;      outchar para repintar o tile correto.
    ;
    ;   3. MOVE: incrementa ou decrementa a posição e aplica wrap
    ;      horizontal (volta à borda oposta da faixa).
    ;      Se extra_steps > 0, move 2 ou 3 casas por ciclo.
    ;
    ;   4. DRAW: exibe a letra do inimigo na nova posição.
    ; =========================================================

    ; Y 
        load r0, y_delay_cnt
        inc r0
        store y_delay_cnt, r0

        loadn r5, #1   
        load r6, game_speed
        sub r5, r5, r6

        ; limite mínimo = 2
        loadn r6, #1
        cmp r5, r6
        jgr y_ok_speed
        loadn r5, #1

    y_ok_speed:

        cmp r0, r5
        jgr y_move
        jeq y_move
        jmp y_draw

    y_move:
    loadn r0, #0
    store y_delay_cnt, r0

    load r0, pos_y_inimigo   ; <-- carrega posição atual

    ; --- Apaga inimigo Y na posição atual ---
    ; Técnica de apagamento: lê o valor do tile de fundo da tela
    ; ativa na posição do inimigo e redesenha esse tile,
    ; efetivamente "apagando" o inimigo sem sujar o mapa.
    ; r5 aponta para o array da tela ativa (tela1..tela4).
    load r5, tela_atual
    loadn r6, #1
    cmp r5, r6
    jeq apagaY_tela2
    loadn r6, #2
    cmp r5, r6
    jeq apagaY_tela3
    loadn r6, #3
    cmp r5, r6
    jeq apagaY_tela4
    loadn r5, #tela1
    jmp apagaY_faz
apagaY_tela2:
    loadn r5, #tela2
    jmp apagaY_faz
apagaY_tela3:
    loadn r5, #tela3
    jmp apagaY_faz
apagaY_tela4:
    loadn r5, #tela4
apagaY_faz:
    add r5, r5, r0
    loadi r5, r5
    outchar r5, r0

    ; --- Avança Y para a ESQUERDA (decrementa posição) ---
    ; Faixa do Y: colunas 0-39 na linha 3 (posições 120-159).
    ; Ao atingir a posição 119 (antes da faixa), faz wrap para 159.
    dec r0
    loadn r5, #119
    cmp r0, r5
    jne y_skip_wrap1
    loadn r0, #159        ; wrap: volta ao extremo direito da faixa
y_skip_wrap1:
    ; --- extra_steps: move 2 ou 3 casas por ciclo (dificuldade alta) ---
    ; extra_steps=0 → 1 passo; =1 → 2 passos; =2 → 3 passos.
    ; Cada passo adicional também verifica o wrap de faixa.
    load r5, extra_steps
    loadn r6, #0
    cmp r5, r6
    jeq y_ok             ; extra_steps=0: nenhum passo extra
    dec r0
    loadn r6, #119
    cmp r0, r6
    jne y_skip_wrap2
    loadn r0, #159
y_skip_wrap2:
    loadn r6, #1
    cmp r5, r6
    jeq y_ok
    dec r0
    loadn r6, #119
    cmp r0, r6
    jne y_ok
    loadn r0, #159
y_ok:
    store pos_y_inimigo, r0

    y_draw:
        load r0, pos_y_inimigo
        loadn r5, #'Y'
        outchar r5, r0

    ; Y2
        load r0, y2_delay_cnt
        inc r0
        store y2_delay_cnt, r0

        loadn r5, #1   
        load r6, game_speed
        sub r5, r5, r6
        loadn r6, #1
        cmp r5, r6
        jgr y2_ok_speed
        loadn r5, #1
    y2_ok_speed:
        cmp r0, r5
        jgr y2_move
        jeq y2_move
        jmp y2_draw

    y2_move:
    loadn r0, #0
    store y2_delay_cnt, r0
    load r0, pos_y2_inimigo
    load r5, tela_atual
    loadn r6, #1
    cmp r5, r6
    jeq apagaY2_tela2
    loadn r6, #2
    cmp r5, r6
    jeq apagaY2_tela3
    loadn r6, #3
    cmp r5, r6
    jeq apagaY2_tela4
    loadn r5, #tela1
    jmp apagaY2_faz
apagaY2_tela2:
    loadn r5, #tela2
    jmp apagaY2_faz
apagaY2_tela3:
    loadn r5, #tela3
    jmp apagaY2_faz
apagaY2_tela4:
    loadn r5, #tela4
apagaY2_faz:
    add r5, r5, r0
    loadi r5, r5
    outchar r5, r0
    dec r0
    loadn r5, #119
    cmp r0, r5
    jne y2_skip_wrap1
    loadn r0, #159
y2_skip_wrap1:
    load r5, extra_steps
    loadn r6, #0
    cmp r5, r6
    jeq y2_ok
    dec r0
    loadn r6, #119
    cmp r0, r6
    jne y2_skip_wrap2
    loadn r0, #159
y2_skip_wrap2:
    loadn r6, #1
    cmp r5, r6
    jeq y2_ok
    dec r0
    loadn r6, #119
    cmp r0, r6
    jne y2_ok
    loadn r0, #159
y2_ok:
    store pos_y2_inimigo, r0
    y2_draw:
        load r0, pos_y2_inimigo
        loadn r5, #'Y'
        outchar r5, r0

    ; Y3
        load r0, y3_delay_cnt
        inc r0
        store y3_delay_cnt, r0

        loadn r5, #1   
        load r6, game_speed
        sub r5, r5, r6
        loadn r6, #1
        cmp r5, r6
        jgr y3_ok_speed
        loadn r5, #1
    y3_ok_speed:
        cmp r0, r5
        jgr y3_move
        jeq y3_move
        jmp y3_draw

    y3_move:
    loadn r0, #0
    store y3_delay_cnt, r0
    load r0, pos_y3_inimigo
    load r5, tela_atual
    loadn r6, #1
    cmp r5, r6
    jeq apagaY3_tela2
    loadn r6, #2
    cmp r5, r6
    jeq apagaY3_tela3
    loadn r6, #3
    cmp r5, r6
    jeq apagaY3_tela4
    loadn r5, #tela1
    jmp apagaY3_faz
apagaY3_tela2:
    loadn r5, #tela2
    jmp apagaY3_faz
apagaY3_tela3:
    loadn r5, #tela3
    jmp apagaY3_faz
apagaY3_tela4:
    loadn r5, #tela4
apagaY3_faz:
    add r5, r5, r0
    loadi r5, r5
    outchar r5, r0
    dec r0
    loadn r5, #119
    cmp r0, r5
    jne y3_skip_wrap1
