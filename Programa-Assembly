    ; =========================================================
    ; LEITURA DE ENTRADA DO TECLADO
    ; =========================================================
    ; inchar lê um caractere sem bloquear (retorna 0 se vazio).
    ; Teclas aceitas: W (cima), S (baixo), A (esquerda), D (direita).
    ; O jogador NÃO pode sair dos limites laterais (col 0..39)
    ; nem ultrapassar a linha 29 para baixo.
    ; Ao pressionar W na linha 0: ocorre wrap vertical → pontua.
    ; =========================================================
    inchar r6

    loadn r5, #'d'
    cmp r6, r5
    jne checkA
    ; Tecla 'D' — move para a DIREITA (col+1), limite col=39
    loadn r5, #39
    cmp r1, r5
    jeq continua          ; já na última coluna: ignora
    inc r1
    jmp apaga_e_continua

checkA:
    ; Tecla 'A' — move para a ESQUERDA (col-1), limite col=0
    loadn r5, #'a'
    cmp r6, r5
    jne checkW
    loadn r5, #0
    cmp r1, r5
    jeq continua          ; já na primeira coluna: ignora
    dec r1
    jmp apaga_e_continua

checkW:
    ; Tecla 'W' — move para CIMA (linha-1)
    ; Caso especial: se já está na linha 0, ocorre WRAP VERTICAL:
    ;   - Adiciona +10 à pontuação
    ;   - Aumenta game_speed (dificuldade)
    ;   - Troca o mapa (tela_atual cicla entre 0-3)
    ;   - Reseta o jogador para a linha 29
    loadn r5, #'w'
    cmp r6, r5
    jne checkS

    loadn r5, #0
    cmp r2, r5
    jne normalUp          ; linha > 0: sobe normalmente

    ; --- WRAP VERTICAL: jogador ultrapassou o topo ---
    load r0, pontuacao
    loadn r5, #10         ; incremento de pontos por wrap
    add r0, r0, r5
    store pontuacao, r0

    ; --- Aumenta a velocidade global (cap em 100) ---
    ; game_speed reduz o delay de todos os inimigos, tornando-os mais rápidos.
    load r0, game_speed
    loadn r5, #100
    cmp r0, r5
    jeq nao_aumenta       ; já no máximo: não aumenta
    loadn r5, #2
    add r0, r0, r5
    store game_speed, r0

nao_aumenta:
    ; === ALTERNA TELA (0 -> 1 -> 2 -> 3 -> 0) ===
    ; Cicla o índice do mapa para exibir o próximo cenário visual.
    load r0, tela_atual
    inc r0
    loadn r5, #4
    cmp r0, r5
    jne alterna_salva
    loadn r0, #0

alterna_salva:
    store tela_atual, r0

    ; contador de wraps verticais
    load r0, wrap_vertical_cnt
    inc r0
    store wrap_vertical_cnt, r0

    ; --- Velocidade extra por quantidade de wraps verticais ---
    ; Quanto mais o jogador atravessa o topo, maior o bônus de speed:
    ;   0-10  wraps → +3  (dificuldade inicial)
    ;   11-15 wraps → +6  (dificuldade média)
    ;   16+   wraps → +10 (dificuldade máxima)
    loadn r5, #10
    cmp r0, r5
    jgr wrap_vel_forte
    jeq wrap_vel_forte
    loadn r5, #3
    jmp wrap_vel_aplica

wrap_vel_forte:
    loadn r5, #15
    cmp r0, r5
    jgr wrap_vel_extremo
    jeq wrap_vel_extremo
    loadn r5, #6
    jmp wrap_vel_aplica

wrap_vel_extremo:
    loadn r5, #10

wrap_vel_aplica:
    load r0, game_speed
    add r0, r0, r5
    loadn r6, #100
    cmp r0, r6
    jgr wrap_vel_cap
    jmp wrap_vel_store

wrap_vel_cap:
    loadn r0, #100

wrap_vel_store:
    store game_speed, r0

    ; --- Define extra_steps com base nos wraps acumulados ---
    ; extra_steps controla quantos passos adicionais os inimigos
    ; dão por ciclo, aumentando a dificuldade de desviar:
    ;   0-5   wraps → extra_steps = 0 (1 passo por ciclo)
    ;   6-10  wraps → extra_steps = 1 (2 passos por ciclo)
    ;   11+   wraps → extra_steps = 2 (3 passos por ciclo)
    load r0, wrap_vertical_cnt
    loadn r5, #5
    cmp r0, r5
    jgr speed_nivel2
    jeq speed_nivel2
    loadn r0, #0
    store extra_steps, r0
    jmp fim_extra

speed_nivel2:
    loadn r5, #10
    cmp r0, r5
    jgr speed_nivel3
    jeq speed_nivel3
    loadn r0, #1
    store extra_steps, r0
    jmp fim_extra

speed_nivel3:
