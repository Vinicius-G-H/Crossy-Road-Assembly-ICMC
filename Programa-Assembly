apaga_e_continua:
    ; =========================================================
    ; APAGA O JOGADOR NA POSIÇÃO ANTERIOR
    ; =========================================================
    ; Após mover, restaura o tile de fundo na posição onde
    ; o jogador estava antes (pos_anterior), eliminando o 'X'.
    ; A mesma técnica de apagamento dos inimigos é usada:
    ; lê o tile do array estático da tela ativa e redesenha.
    ; apaga X na posição ANTERIOR (restaura background)
    load r0, pos_anterior
    load r5, tela_atual
    loadn r6, #1
    cmp r5, r6
    jeq apagaX_tela2
    loadn r6, #2
    cmp r5, r6
    jeq apagaX_tela3
    loadn r6, #3
    cmp r5, r6
    jeq apagaX_tela4
    loadn r5, #tela1
    jmp apagaX_faz
apagaX_tela2:
    loadn r5, #tela2
    jmp apagaX_faz
apagaX_tela3:
    loadn r5, #tela3
    jmp apagaX_faz
apagaX_tela4:
    loadn r5, #tela4
apagaX_faz:
    add r5, r5, r0
    loadi r5, r5
    outchar r5, r0

continua:
    jmp loop

    ; =========================================================
    ; GAME OVER
    ; =========================================================
    ; Atingido quando o jogador ocupa a mesma posição de um inimigo.
    ; Sequência:
    ;   1. Desempilha registradores salvos durante a detecção de colisão
    ;   2. Limpa a tela com espaços
    ;   3. Exibe "GAME OVER" e a pontuação final (4 dígitos)
    ;   4. Pergunta "NOVO JOGO? S/N" e aguarda resposta
    ;      'S' → reinicia do zero (jmp main)
    ;      'N' → halt
    ; =========================================================
    game_over:
        ; 1. Limpa a pilha (evita erro de stack overflow ao reiniciar)
        pop r5
        pop r4
        pop r0

        ; 2. Limpa a tela com espaços
        loadn r0, #' '      
        loadn r1, #0
        loadn r2, #1200
    limpa_go:
        outchar r0, r1
        inc r1
        cmp r1, r2
        jne limpa_go

        ; 3. Escreve "GAME OVER" na linha 12
        loadn r0, #495      
        loadn r1, #'G'
        outchar r1, r0
        inc r0
        loadn r1, #'A'
        outchar r1, r0
        inc r0
        loadn r1, #'M'
        outchar r1, r0
        inc r0
        loadn r1, #'E'
        outchar r1, r0
        inc r0
        inc r0              ; Espaço
        loadn r1, #'O'
        outchar r1, r0
        inc r0
        loadn r1, #'V'
        outchar r1, r0
        inc r0
        loadn r1, #'E'
        outchar r1, r0
        inc r0
        loadn r1, #'R'
        outchar r1, r0
        ; Escreve "PONTOS: " na linha 13 (pos 520)
        loadn r0, #535
        loadn r1, #'P'
        outchar r1, r0
        inc r0
        loadn r1, #'O'
        outchar r1, r0
        inc r0
        loadn r1, #'N'
        outchar r1, r0
        inc r0
        loadn r1, #'T'
        outchar r1, r0
        inc r0
        loadn r1, #'O'
        outchar r1, r0
        inc r0
        loadn r1, #'S'
        outchar r1, r0
        inc r0
        loadn r1, #':'
        outchar r1, r0
        inc r0
        loadn r1, #' '
        outchar r1, r0
        inc r0

        ; --- Converte pontuação para texto e exibe ---
        ; A pontuação é múltipla de 10, máximo esperado ~9990.
        ; Como não há divisão nativa, divide-se por subtração:
        ;   milhares: subtrai 1000 enquanto r2 >= 1000, conta em r3
        ;   centenas: subtrai  100 enquanto r2 >=  100, conta em r3
        ;   dezenas:  subtrai   10 enquanto r2 >=   10, conta em r3
        ;   unidades: resto em r2
        ; Cada dígito é convertido para ASCII somando '0' (48).
        load r2, pontuacao

         ; --- Milhares ---
        loadn r3, #0
    div_mil:
        loadn r5, #1000
        cmp r2, r5
        jgr faz_mil
        jeq faz_mil
        jmp depois_mil
    faz_mil:
        sub r2, r2, r5
        inc r3
        jmp div_mil
    depois_mil:
        loadn r5, #'0'
        add r3, r3, r5
        outchar r3, r0
        inc r0

        ; --- Centenas ---
        loadn r3, #0
    div_cen:
        loadn r5, #100
        cmp r2, r5
        jgr faz_cen
        jeq faz_cen
        jmp depois_cen
    faz_cen:
        sub r2, r2, r5
        inc r3
        jmp div_cen
    depois_cen:
        loadn r5, #'0'
        add r3, r3, r5
        outchar r3, r0
        inc r0

        ; --- Dezenas ---
        loadn r3, #0
    div_dez:
        loadn r5, #10
        cmp r2, r5
        jgr faz_dez
        jeq faz_dez
        jmp depois_dez
    faz_dez:
        sub r2, r2, r5
        inc r3
        jmp div_dez
    depois_dez:
        loadn r5, #'0'
        add r3, r3, r5
        outchar r3, r0
        inc r0

        ; --- Unidades ---
        loadn r5, #'0'
        add r2, r2, r5
        outchar r2, r0
        
        
        
        ; 4. Pergunta "NOVO JOGO? S/N" na linha 14
        loadn r0, #572      
        loadn r1, #'N'
        outchar r1, r0
        inc r0
        loadn r1, #'O'
        outchar r1, r0
        inc r0
        loadn r1, #'V'
        outchar r1, r0
        inc r0
        loadn r1, #'O'
        outchar r1, r0
        inc r0
        inc r0
        loadn r1, #'J'
        outchar r1, r0
        inc r0
        loadn r1, #'O'
        outchar r1, r0
        inc r0
        loadn r1, #'G'
        outchar r1, r0
        inc r0
        loadn r1, #'O'
        outchar r1, r0
        inc r0
        loadn r1, #'?'
        outchar r1, r0
        inc r0
        loadn r1, #' '
        outchar r1, r0
        inc r0
        loadn r1, #'S'
        outchar r1, r0
        inc r0
        loadn r1, #'/'
        outchar r1, r0
        inc r0
        loadn r1, #'N'
        outchar r1, r0

    ; --- Aguarda resposta 'S' ou 'N' ---
    espera_escolha:
        inchar r6           
        loadn r5, #'s'
        cmp r6, r5
        jeq reinicia        ; 'S' → reinicia o jogo
        
        loadn r5, #'n'
        cmp r6, r5
        jne espera_escolha  ; qualquer outra tecla: aguarda de novo

    fim_real:
        halt                ; 'N' → encerra o programa

    reinicia:
        jmp main            ; reinicia do início, zerando tudo
        

